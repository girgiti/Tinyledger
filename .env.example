# ─────────────────────────────────────────────────────────────
# Tinyledger — Environment Variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production (Cloudflare Pages), set these same variables under:
#   Pages project → Settings → Environment variables
#
# .env.local is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────

# From your Supabase project: Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# From your Supabase project: Settings → API → anon public key
# (Safe to expose client-side — Row Level Security is what actually
# protects your data, not secrecy of this key.)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional — cosmetic only, shown on the login screen and header.
# Defaults to "Your Venture Name" / "BUSINESS ACCOUNTS · SUPABASE" if unset.
VITE_ORG_NAME=Your Venture Name
VITE_ORG_TAGLINE=BUSINESS ACCOUNTS · SUPABASE
